{
  "uid": "offcon-service-red",
  "title": "OFFCON — Service Detail (RED)",
  "tags": ["offcon", "service", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(up{job=~\"offcon-services.*\"}, service)",
        "current": { "text": "auth-svc", "value": "auth-svc" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rate · Errors · Duration — $service",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate (by status)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total{service=\"$service\"}[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Ratio",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "service:http_errors:ratio5m{service=\"$service\"}", "legendFormat": "5xx ratio", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity" },
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency Quantiles",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "service:http_latency:p50_5m{service=\"$service\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "service:http_latency:p95_5m{service=\"$service\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "service:http_latency:p99_5m{service=\"$service\"}", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Latency Heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m]))", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A" }
      ],
      "options": { "calculate": false, "cellGap": 1, "color": { "scheme": "Turbo", "mode": "scheme" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top Endpoints by Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "topk(8, sum by (path) (rate(http_requests_total{service=\"$service\"}[5m])))", "legendFormat": "{{path}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Goroutines / Threads",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "go_goroutines{service=\"$service\"}", "legendFormat": "goroutines", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Heap Memory",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "go_memstats_heap_inuse_bytes{service=\"$service\"}", "legendFormat": "heap in-use", "refId": "A" },
        { "expr": "process_resident_memory_bytes{service=\"$service\"}", "legendFormat": "RSS", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GC Pause / CPU",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{service=\"$service\"}[5m])", "legendFormat": "cpu cores", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs — $service",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 },
      "datasource": { "uid": "loki" },
      "targets": [{ "expr": "{service=\"$service\"}", "refId": "A" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
