{
  "uid": "offcon-business",
  "title": "OFFCON — Business KPIs",
  "tags": ["offcon", "business", "kpi"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Signups (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(offcon_signups_total[24h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MRR",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "offcon:mrr:cents / 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flags Submitted (rate)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "offcon:flags_submitted:rate5m", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spawn Success Rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "offcon:spawn_success:ratio5m", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.97 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Signups Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(offcon_signups_total[1h])) * 3600", "legendFormat": "signups/hour", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50 } } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active Lab Instances",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "offcon:active_instances:total", "legendFormat": "running", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity" }, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Machine Spawns (success vs error)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(offcon_instance_spawn_total{result=\"success\"}[5m]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(rate(offcon_instance_spawn_total{result=\"error\"}[5m]))", "legendFormat": "error", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Flag Submissions (accepted vs rejected)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(offcon_flag_submissions_total{result=\"accepted\"}[5m]))", "legendFormat": "accepted", "refId": "A" },
        { "expr": "sum(rate(offcon_flag_submissions_total{result=\"rejected\"}[5m]))", "legendFormat": "rejected", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 14,
      "type": "piechart",
      "title": "Subscriptions by Plan",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (plan) (offcon_active_subscriptions)", "legendFormat": "{{plan}}", "refId": "A" }
      ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Payments (succeeded vs failed)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(offcon_payment_attempts_total{result=\"succeeded\"}[15m]))", "legendFormat": "succeeded", "refId": "A" },
        { "expr": "sum(rate(offcon_payment_attempts_total{result=\"failed\"}[15m]))", "legendFormat": "failed", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Notification Queue Depth",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "offcon_notification_queue_depth", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    }
  ]
}
