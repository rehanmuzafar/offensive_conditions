# CTF service env template
APP_ENV=development
APP_NAME=ctf-svc
APP_VERSION=0.1.0

HTTP_PORT=8004
HTTP_HOST=0.0.0.0
HTTP_WORKERS=2
HTTP_CORS_ORIGINS=["http://localhost:3000"]

GRPC_PORT=9004
GRPC_ENABLE_REFLECTION=true
GRPC_MAX_RECV_MB=8

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=ctf_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW_SECONDS=5

KAFKA_BROKERS=["localhost:9092"]
KAFKA_TOPIC_CTF_EVENTS=ctf.events
KAFKA_TOPIC_FLAGVERIFY_EVENTS=flagverify.events
KAFKA_CONSUMER_GROUP=ctf-svc
KAFKA_USE_TLS=false
KAFKA_ACKS=all

FLAG_VERIFIER_ADDR=localhost:9002
FLAG_VERIFIER_USE_TLS=false
FLAG_VERIFIER_TIMEOUT_SECONDS=5.0
USER_SVC_ADDR=localhost:9001

DYNAMIC_SCORING_DECAY_FACTOR=0.012
DYNAMIC_SCORING_DECAY_POWER=4
FIRST_BLOOD_BONUS_PERCENTAGES=[0.05, 0.03, 0.01]
DEFAULT_FREEZE_MINUTES_BEFORE_END=60

WS_MAX_CONNECTIONS_PER_EVENT=5000
WS_HEARTBEAT_SECONDS=30
WS_IDLE_TIMEOUT_SECONDS=300

LIMIT_PAGE_SIZE_DEFAULT=25
LIMIT_PAGE_SIZE_MAX=100
LIMIT_SUBMIT_PER_MINUTE=30
LIMIT_ANNOUNCEMENT_MAX_CHARS=4000

LOG_LEVEL=info
LOG_FORMAT=console
