APP_ENV=development
APP_NAME=bounty-svc
APP_VERSION=0.1.0

HTTP_PORT=8009
HTTP_HOST=0.0.0.0
HTTP_WORKERS=2
HTTP_CORS_ORIGINS=["http://localhost:3000"]

GRPC_PORT=9009
GRPC_ENABLE_REFLECTION=true
GRPC_MAX_RECV_MB=8

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=bounty_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=8
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api

KAFKA_BROKERS=["localhost:9092"]
KAFKA_TOPIC_BOUNTY_EVENTS=bounty.events
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events
KAFKA_CONSUMER_GROUP=bounty-svc
KAFKA_USE_TLS=false
KAFKA_ACKS=all

PAYMENT_SVC_ADDR=localhost:9007
NOTIFICATION_SVC_ADDR=localhost:9008
USER_SVC_ADDR=localhost:9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=offcon-bounty-attachments
S3_PRESIGNED_TTL_SECONDS=600
S3_USE_SSL=false

LIMIT_PAGE_SIZE_DEFAULT=25
LIMIT_PAGE_SIZE_MAX=100
LIMIT_REPORT_DESC_MAX_CHARS=50000
LIMIT_ATTACHMENT_MAX_MB=100
LIMIT_COMMENTS_PER_USER_PER_MIN=30
LIMIT_REPORTS_PER_USER_PER_DAY=20

SEVERITY_DEFAULT_CAP_CENTS_CRITICAL=1000000
SEVERITY_DEFAULT_CAP_CENTS_HIGH=300000
SEVERITY_DEFAULT_CAP_CENTS_MEDIUM=100000
SEVERITY_DEFAULT_CAP_CENTS_LOW=25000

LOG_LEVEL=info
LOG_FORMAT=console
