APP_ENV=development
APP_NAME=writeup-svc
APP_VERSION=0.1.0

HTTP_PORT=8006
HTTP_HOST=0.0.0.0
HTTP_WORKERS=2
HTTP_CORS_ORIGINS=["http://localhost:3000"]

GRPC_PORT=9006
GRPC_ENABLE_REFLECTION=true
GRPC_MAX_RECV_MB=8

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=writeup_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api

KAFKA_BROKERS=["localhost:9092"]
KAFKA_TOPIC_WRITEUP_EVENTS=writeup.events
KAFKA_CONSUMER_GROUP=writeup-svc
KAFKA_USE_TLS=false
KAFKA_ACKS=all

SCORING_SVC_ADDR=localhost:9004
CONTENT_SVC_ADDR=localhost:9003

LIMIT_PAGE_SIZE_DEFAULT=25
LIMIT_PAGE_SIZE_MAX=100
LIMIT_WRITEUP_MAX_CHARS=200000
LIMIT_COMMENT_MAX_CHARS=10000
LIMIT_SUBMIT_PER_USER_PER_DAY=5

REQUIRE_SOLVE_TO_READ=true
GRACE_FOR_AUTHORS=true

LOG_LEVEL=info
LOG_FORMAT=console
