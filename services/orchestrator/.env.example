# =============================================================================
# Offensive Conditions - Lab Orchestrator - Example Environment
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Production deployments use Kubernetes Secrets / Vault (see deployments/).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                # development | production
APP_NAME=orchestrator
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# HTTP Server
# -----------------------------------------------------------------------------
HTTP_PORT=8002
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# gRPC Server (internal service-to-service)
# -----------------------------------------------------------------------------
GRPC_PORT=9002
GRPC_ENABLE_REFLECTION=true

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=svc_orchestrator
DB_PASSWORD=change-me-for-dev      # in prod use Vault
DB_SSLMODE=disable                 # in prod use 'require'
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Auth Service (for JWT validation)
# -----------------------------------------------------------------------------
AUTH_GRPC_ENDPOINT=localhost:9001
AUTH_JWT_PUBLIC_KEY_PATH=../auth/secrets/jwt-public.pem
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW=5s
AUTH_INSECURE=true                 # MUST be false in production
AUTH_TOKEN_CACHE_TTL=30s

# -----------------------------------------------------------------------------
# Kubernetes Backend
# -----------------------------------------------------------------------------
K8S_IN_CLUSTER=false                                   # true when running inside cluster
K8S_KUBECONFIG=/Users/you/.kube/config                 # path when out-of-cluster
K8S_LAB_NAMESPACE=lab-instances
K8S_RUNTIME_CLASS=                                     # set to 'gvisor' in production
K8S_STORAGE_CLASS=
K8S_NETWORK_ATTACH_DEF=                                # Multus net-attach-def name
K8S_CPU_LIMIT=2
K8S_MEM_LIMIT=4Gi
K8S_IMAGE_PULL_SECRET=

# -----------------------------------------------------------------------------
# Proxmox Backend (optional - leave PROXMOX_ENDPOINT blank to disable)
# -----------------------------------------------------------------------------
PROXMOX_ENDPOINT=
PROXMOX_USER=orchestrator@pve
PROXMOX_TOKEN_ID=orchestrator!ci
PROXMOX_TOKEN_SECRET=
PROXMOX_DEFAULT_NODE=pve01
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_VERIFY_TLS=true
PROXMOX_API_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Network / VPN
# -----------------------------------------------------------------------------
NETWORK_USER_SUBNET_BASE=10.10.0.0/16    # base pool carved into per-user /24
NETWORK_USER_SUBNET_SIZE=24              # /24 per user
NETWORK_INSTANCE_SUBNET_SIZE=30          # /30 per instance
WIREGUARD_API=                           # leave blank in dev (no-op)
WIREGUARD_API_KEY=
VPN_GATEWAY_IP=10.200.0.1
FIREWALL_API=

# -----------------------------------------------------------------------------
# Flag Generation
# -----------------------------------------------------------------------------
FLAG_HMAC_SECRET=dev-secret-do-not-use-in-prod   # min 32 bytes in prod
FLAG_PREFIX=OFFCON

# -----------------------------------------------------------------------------
# Lifecycle
# -----------------------------------------------------------------------------
INSTANCE_DEFAULT_TTL=8h
INSTANCE_MAX_TTL=24h
INSTANCE_EXTEND_STEP=4h
INSTANCE_MAX_EXTENSIONS=3
REAPER_INTERVAL=60s
INSTANCE_GRACE_DURATION=5m
INSTANCE_HEALTH_INTERVAL=30s

# -----------------------------------------------------------------------------
# Kafka (event publishing)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INSTANCE_EVENTS=instance.events
KAFKA_TOPIC_FLAG_SUBMISSIONS=flag.submissions
KAFKA_USE_TLS=false

# -----------------------------------------------------------------------------
# Quotas
# -----------------------------------------------------------------------------
QUOTA_CONCURRENT_FREE=1            # free users: 1 concurrent instance
QUOTA_CONCURRENT_PRO=4             # pro users: 4 concurrent
QUOTA_MONTHLY_HOURS_FREE=40        # free: 40h/month
QUOTA_MONTHLY_HOURS_PRO=300        # pro: 300h/month

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info                     # debug | info | warn | error
LOG_FORMAT=console                 # console (dev) | json (prod)
