# Flag Verifier — local dev env
# Copy to .env, adjust as needed. Do NOT commit .env.

APP_ENV=development
APP_NAME=flag-verifier
APP_VERSION=0.1.0

HTTP_PORT=8005
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_TRUSTED_PROXIES=127.0.0.1,::1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=svc_flag_verifier
DB_PASSWORD=svc_flag_verifier_password
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt_public.pem
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW=5s
AUTH_TOKEN_CACHE_TTL=30s

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_FLAG_SUBMISSIONS=flag.submissions
KAFKA_USE_TLS=false
KAFKA_ACKS=all

# Vault disabled by default in dev — use SECRETS_LOCAL_KEY env var instead
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_TOKEN_PATH=
VAULT_FLAG_SECRETS_PATH=secret/data/flag-hmac
VAULT_REFRESH_INTERVAL=5m

# Dev-only fallback secret (used when VAULT_ENABLED=false)
SECRETS_LOCAL_KEY=dev-only-shared-secret-for-all-machines-replace-in-prod

RL_PER_CONTENT_PER_MIN=10
RL_PER_USER_PER_MIN=100
RL_PER_IP_PER_MIN=200
RL_COOLDOWN_SECONDS=60
RL_IP_COOLDOWN_SECONDS=300
RL_WINDOW_SECONDS=60

IDEMPOTENCY_TTL_SECONDS=60
IDEMPOTENCY_ENABLED=true

FLAG_PREFIX=OFFCON{
FLAG_SUFFIX=}
FLAG_HMAC_BYTES=16
FLAG_MAX_LENGTH=256

ORCHESTRATOR_GRPC_ADDR=localhost:9001
ORCHESTRATOR_GRPC_TIMEOUT=2s
ORCHESTRATOR_ENABLED=false

LOG_LEVEL=debug
LOG_FORMAT=console
