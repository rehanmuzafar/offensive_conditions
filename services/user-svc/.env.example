# =============================================================================
# user-svc environment example. Copy to .env for local dev.
# Production values are baked into the ConfigMap + Secret in K8s.
# =============================================================================

# --- App ---
APP_ENV=development                 # development | staging | production
APP_NAME=user-svc
APP_VERSION=0.1.0

# --- HTTP ---
HTTP_PORT=8001
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_TRUSTED_PROXIES=127.0.0.1/32
HTTP_CORS_ORIGINS=http://localhost:3000
HTTP_MAX_AVATAR_BYTES=2097152

# --- gRPC ---
GRPC_PORT=9001
GRPC_ENABLE_REFLECTION=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=user_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_POOL_SIZE=20
REDIS_TLS=false

# --- Auth (JWT validation) ---
AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW=5s
AUTH_TOKEN_CACHE_TTL=30s

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=user-svc
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_USE_TLS=false

# --- Object Storage (MinIO/S3) ---
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_AVATAR_BUCKET=offcon-avatars
STORAGE_EXPORT_BUCKET=offcon-gdpr-exports
STORAGE_CDN_BASE_URL=

# --- Limits ---
LIMIT_USERNAME_MIN_LENGTH=3
LIMIT_USERNAME_MAX_LENGTH=32
LIMIT_BIO_MAX_LENGTH=500
LIMIT_MAX_FRIENDS_FREE=100
LIMIT_MAX_FRIENDS_PRO=1000
LIMIT_MAX_TEAM_SIZE_FREE=5
LIMIT_MAX_TEAM_SIZE_PRO=25
LIMIT_MAX_TEAMS_PER_USER=5
LIMIT_INVITATION_TTL=168h
LIMIT_FRIEND_REQUEST_TTL=720h

# --- GDPR ---
GDPR_DELETION_GRACE_PERIOD=720h    # 30 days
GDPR_EXPORT_TTL=168h               # 7 days
GDPR_EXPORT_SIGNED_URL_TTL=24h

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF=500ms

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=console                 # console | json
