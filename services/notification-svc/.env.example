APP_ENV=development
APP_NAME=notification-svc
APP_VERSION=0.1.0

HTTP_PORT=8008
HTTP_HOST=0.0.0.0
HTTP_CORS_ORIGINS=http://localhost:3000

GRPC_PORT=9008

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=notification_svc
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=7
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api

EMAIL_FROM_ADDRESS=noreply@offensiveconditions.org
EMAIL_FROM_NAME=Offensive Conditions
EMAIL_REPLY_TO=support@offensiveconditions.org
EMAIL_PROVIDER_PRIMARY=mock
EMAIL_PROVIDER_FAILOVER=none

RESEND_API_KEY=
SENDGRID_API_KEY=

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-svc
KAFKA_USE_TLS=false
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_TOPIC_SCORING_EVENTS=scoring.events
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events
KAFKA_TOPIC_FORUM_EVENTS=forum.events
KAFKA_TOPIC_WRITEUP_EVENTS=writeup.events
KAFKA_TOPIC_CTF_EVENTS=ctf.events

WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_SIGNATURE_HEADER=X-Offcon-Signature
WEBHOOK_TIMESTAMP_HEADER=X-Offcon-Timestamp

USER_SVC_ADDR=localhost:9001

DEFAULT_QUIET_HOURS_START=22
DEFAULT_QUIET_HOURS_END=7

PER_USER_EMAIL_PER_HOUR=20
PER_USER_NOTIFICATIONS_PER_MIN=60

LOG_LEVEL=info
LOG_FORMAT=pretty
