# =============================================================================
# Content service environment variables (copy to .env for local dev)
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=content-svc
APP_VERSION=0.1.0

# --- HTTP ---
HTTP_PORT=8003
HTTP_HOST=0.0.0.0
HTTP_WORKERS=2
HTTP_CORS_ORIGINS=["http://localhost:3000"]
HTTP_MAX_UPLOAD_MB=50

# --- gRPC ---
GRPC_PORT=9003
GRPC_ENABLE_REFLECTION=true
GRPC_MAX_RECV_MB=8

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=content_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_TLS=false

# --- Auth (JWT) ---
AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW_SECONDS=5

# --- Kafka ---
KAFKA_BROKERS=["localhost:9092"]
KAFKA_TOPIC_CONTENT_EVENTS=content.events
KAFKA_TOPIC_SCORING_EVENTS=scoring.events
KAFKA_CONSUMER_GROUP=content-svc
KAFKA_USE_TLS=false
KAFKA_ACKS=all

# --- Storage (MinIO/S3) ---
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_MEDIA_BUCKET=offcon-content-media
STORAGE_FILES_BUCKET=offcon-content-files
STORAGE_CDN_BASE_URL=http://localhost:9000

# --- Limits ---
LIMIT_SEARCH_MAX_RESULTS=100
LIMIT_PAGE_SIZE_DEFAULT=25
LIMIT_PAGE_SIZE_MAX=100
LIMIT_REVIEW_MAX_CHARS=5000
LIMIT_MACHINE_INTRO_MAX_CHARS=50000
LIMIT_MACHINE_WALKTHROUGH_MAX_CHARS=200000

# --- Tier gating ---
FREE_TIER_MACHINE_QUOTA_PER_MONTH=10

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=console
