# =============================================================================
# Scoring Service — local development environment variables
# Copy to .env and adjust as needed. Do NOT commit .env.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=scoring
APP_VERSION=0.1.0

# HTTP
HTTP_PORT=8003
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_TRUSTED_PROXIES=127.0.0.1,::1

# gRPC
GRPC_PORT=9003
GRPC_ENABLE_REFLECTION=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=svc_scoring
DB_PASSWORD=svc_scoring_password
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TLS=false

# ClickHouse (optional, disabled by default)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_ADDRS=localhost:9000
CLICKHOUSE_DATABASE=offcon_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TLS=false

# Auth (JWT validation)
AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt_public.pem
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
AUTH_JWT_CLOCK_SKEW=5s
AUTH_TOKEN_CACHE_TTL=30s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=scoring-svc
KAFKA_TOPIC_FLAG_SUBMISSIONS=flag.submissions
KAFKA_TOPIC_CTF_EVENTS=ctf.events
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_USE_TLS=false

# Points algorithm
POINTS_BASE_VERY_EASY=10
POINTS_BASE_EASY=20
POINTS_BASE_MEDIUM=30
POINTS_BASE_HARD=40
POINTS_BASE_INSANE=50
POINTS_USER_FLAG_SHARE=0.30
POINTS_ROOT_FLAG_SHARE=0.70
POINTS_FIRST_BLOOD_MULT=1.50
POINTS_SECOND_BLOOD_MULT=1.25
POINTS_THIRD_BLOOD_MULT=1.10
POINTS_TIME_DECAY_DAYS=365
POINTS_TIME_DECAY_FLOOR=0.50

# ELO
ELO_INITIAL=1500
ELO_K_FACTOR=32
ELO_K_FACTOR_HIGH=16
ELO_HIGH_THRESHOLD=2400
ELO_PROVISIONAL_MATCHES=10
ELO_K_FACTOR_PROVISIONAL=40
ELO_INACTIVITY_DAYS=60
ELO_DECAY_PER_CYCLE=25

# Seasons
SEASON_DURATION_DAYS=90
SEASON_CARRYOVER_FRACTION=0.25
SEASON_ROLLOVER_GRACE=24h

# Streaks
STREAK_GRACE_MINUTES=0
STREAK_BONUS_EVERY=7
STREAK_BONUS_POINTS=50

# Anti-cheat
ANTICHEAT_ENABLE_SPEED=true
ANTICHEAT_MIN_SOLVE_SECONDS=60
ANTICHEAT_ENABLE_SHARED_FLAG=true
ANTICHEAT_ENABLE_IP_CHANGE=true

# Worker
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=100
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF=500ms

# Service endpoints
USER_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8004

# Logging
LOG_LEVEL=info
LOG_FORMAT=console
