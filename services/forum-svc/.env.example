APP_ENV=development
APP_NAME=forum-svc
APP_VERSION=0.1.0

HTTP_PORT=8005
HTTP_HOST=0.0.0.0
HTTP_WORKERS=2
HTTP_CORS_ORIGINS=["http://localhost:3000"]

GRPC_PORT=9005
GRPC_ENABLE_REFLECTION=true
GRPC_MAX_RECV_MB=8

DB_HOST=localhost
DB_PORT=5432
DB_NAME=offcon
DB_USER=forum_svc
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=4
REDIS_TLS=false

AUTH_JWT_PUBLIC_KEY_PATH=./testdata/jwt.pub
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api

KAFKA_BROKERS=["localhost:9092"]
KAFKA_TOPIC_FORUM_EVENTS=forum.events
KAFKA_CONSUMER_GROUP=forum-svc
KAFKA_USE_TLS=false
KAFKA_ACKS=all

USER_SVC_ADDR=localhost:9001

LIMIT_PAGE_SIZE_DEFAULT=25
LIMIT_PAGE_SIZE_MAX=100
LIMIT_POST_MAX_CHARS=60000
LIMIT_TITLE_MAX_CHARS=200
LIMIT_THREAD_PER_USER_PER_HOUR=10
LIMIT_POST_PER_USER_PER_MINUTE=5

VOTE_SELF_ALLOWED=false
VOTE_MIN_REPUTATION=0

LOG_LEVEL=info
LOG_FORMAT=console
