# ============================================================================
#  OFFCON — local full-stack environment (docker compose).
#  Dev-only values. NEVER use these in production.
#
#  This single file feeds every service via docker-compose `env_file` +
#  per-service overrides. The goal is "docker compose up" → whole platform.
# ============================================================================

# ---- shared infra (containers talk to each other by service name) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=offcon
# Dev simplification: every service connects as the superuser. (Production
# uses the per-service roles created in database/scripts/init.sql.)
DB_USER=offcon_admin
DB_PASSWORD=
DB_SSLMODE=disable

POSTGRES_USER=offcon_admin
POSTGRES_PASSWORD=
POSTGRES_DB=offcon

REDIS_ADDR=redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (KRaft single-broker)
KAFKA_BROKERS=kafka:9092
KAFKA_USE_TLS=false
KAFKA_ACKS=all

# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
# The minio SDK takes host:port (no scheme) plus a separate TLS flag, unlike
# S3_ENDPOINT above which is a full URL. Without this it defaults to
# localhost:9000 — the service container's own loopback, not MinIO.
STORAGE_ENDPOINT=minio:9000
# Where a browser reaches MinIO. Uploaded banner URLs are stored permanently on
# the entity, so they must use this, not the internal minio:9000 host. In
# production point this at the CDN / public object-store domain.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MINIO_ROOT_USER=offcon_dev
MINIO_ROOT_PASSWORD=

# Observability (OTLP → collector, optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DEPLOY_ENV=development
LOG_LEVEL=info
APP_ENV=development

# ---- auth / JWT (shared keypair mounted into services) ----
JWT_PRIVATE_KEY_PATH=/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
AUTH_JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
JWT_ISSUER=https://auth.offensiveconditions.org
JWT_AUDIENCE=offcon-api
# auth signs with JWT_ISSUER/JWT_AUDIENCE above; every other service validates
# with AUTH_JWT_*. These were previously unset, so all 11 consumers silently
# fell back to a hardcoded default — changing the domain in one place broke
# token validation everywhere. Keep all four in sync.
AUTH_JWT_ISSUER=https://auth.offensiveconditions.org
AUTH_JWT_AUDIENCE=offcon-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
TFA_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLED=false
# Verification is ON. Locally the mail lands in Mailpit (http://localhost:8025)
# rather than a real inbox, so read it there to finish signing up.
# Was previously false, which let unverified accounts log straight in —
# new accounts are created "active" and can log in immediately.
SEC_EMAIL_VERIFICATION_REQUIRED=true
# Auth rate limits are keyed by client IP, but behind the edge proxy every
# request shares one IP — so keep these high for local dev to avoid 429s.
RATE_LIMIT_REGISTER_PER_HOUR=1000
RATE_LIMIT_LOGIN_PER_MINUTE=1000
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=1000
RATE_LIMIT_EMAIL_VERIFY_PER_HOUR=1000

# ---- ClickHouse (scoring) — disabled locally, uses Postgres fallback ----
CLICKHOUSE_ENABLED=false

# ---- payment-svc (Stripe test stubs — fill real test keys to exercise) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# ---- SMTP (auth emails — Mailpit catches everything locally) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@offensiveconditions.org
SMTP_FROM_NAME=OFFCON
SMTP_USE_TLS=false

# ---- frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- CTF entry-fee payments ------------------------------------------------
# manual | jazzcash | easypaisa | stripe
# "manual" needs no merchant account: participants are shown the bank details
# below and an organiser confirms each transfer from the admin queue. Switch
# this once a gateway is live; nothing else needs to change.
CTF_PAYMENT_PROVIDER=manual
PAYOUT_ACCOUNT_NAME=
PAYOUT_ACCOUNT_NUMBER=
PAYOUT_BANK_NAME=
PAYOUT_IBAN=

# Both hostnames resolve to this machine, and a browser sends whichever one is
# in the address bar as its Origin. Allowing only localhost meant 127.0.0.1
# users got a 403 on every write — with no CORS message, because the service
# rejects before the CORS layer replies.
HTTP_CORS_ORIGINS=http://localhost:3000 http://127.0.0.1:3000 http://ctf.localhost:3000 http://bugbounty.localhost:3000 http://app.localhost:3000 http://dashboard.localhost:3000

# Shared secret for the orchestrator internal container API (ctf-svc -> orchestrator).
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ORCHESTRATOR_INTERNAL_TOKEN=

# Address players connect to for spawned lab/CTF containers. The Docker daemon
# cannot know this — on a laptop it is 127.0.0.1, on a VPS its public IP.
DOCKER_PUBLIC_HOST=127.0.0.1

# Group that owns /var/run/docker.sock, so the orchestrator (which runs as a
# non-root user) can use the mounted socket. Differs per host:
#   Docker Desktop / colima -> 991,  most Linux distros -> 999
# Check with:  ls -n /var/run/docker.sock   (4th column is the gid)
DOCKER_SOCKET_GID=991

# Root domain the four surfaces hang off (landing / ctf. / bugbounty. / app.).
# Empty in development, which collapses all four onto http://localhost:3000 —
# leave it empty unless you are deploying.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
